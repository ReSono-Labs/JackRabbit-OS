{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jackrabbit:installer:prompts:v1",
  "title": "JackRabbit physical prompt contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "prompts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "prompts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "phase", "category", "title", "reason", "action", "expected", "warning", "verification", "cancel", "nextStates", "surfaces"],
        "properties": {
          "id": { "$ref": "urn:jackrabbit:installer:operations:v1#/$defs/identifier" },
          "phase": { "enum": ["prepare", "fastboot-entry", "first-boot"] },
          "category": {
            "enum": ["PREPARE_ACCOUNT", "BACK_UP", "POWER", "CABLE", "OPEN_OFFICIAL_ENTRY", "SELECT_USB", "OBSERVE_R1", "KEEP_CONNECTED", "RECONNECT", "WAIT_FIRST_BOOT", "MANAGEMENT_HANDOFF"]
          },
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 300 },
          "action": { "type": "string", "minLength": 1, "maxLength": 500 },
          "expected": { "type": "string", "minLength": 1, "maxLength": 300 },
          "warning": { "type": "string", "minLength": 1, "maxLength": 300 },
          "verification": { "enum": ["external-user-attestation", "physical-observation-then-machine-probe", "machine"] },
          "cancel": { "type": "string", "minLength": 1, "maxLength": 200 },
          "nextStates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "urn:jackrabbit:installer:operations:v1#/$defs/identifier" }
          },
          "surfaces": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["web", "cli"] }
          },
          "href": {
            "enum": [
              "https://www.rabbit.tech/support/article/unlock-bootloader-rabbit-r1",
              "https://rabbit-hmi-oss.github.io/flashing/"
            ]
          },
          "linkLabel": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "dependentRequired": {
          "href": ["linkLabel"],
          "linkLabel": ["href"]
        }
      }
    }
  }
}
