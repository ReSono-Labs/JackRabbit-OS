{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jackrabbit:installer:recovery:v1",
  "title": "JackRabbit recovery rules v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "rules"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "fromStates", "resolution"],
        "properties": {
          "id": { "$ref": "urn:jackrabbit:installer:operations:v1#/$defs/identifier" },
          "fromStates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["INTERRUPTED", "REJECTED", "FAILED_SAFE"] }
          },
          "resolution": { "enum": ["STOP", "REPROBE_AND_REPLAN"] }
        }
      }
    }
  }
}
