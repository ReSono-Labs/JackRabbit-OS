{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jackrabbit:installer:signature:v1",
  "title": "JackRabbit detached manifest signature v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "algorithm", "keyId", "manifestSha256", "signature"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "algorithm": { "const": "Ed25519" },
    "keyId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
    "manifestSha256": { "$ref": "urn:jackrabbit:installer:operations:v1#/$defs/sha256" },
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
  }
}
