{
  "name": "@jackrabbit/installer",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "vite build",
    "build:cli": "cargo build --locked --release --manifest-path cli/Cargo.toml",
    "check:boundaries": "bash scripts/check-boundaries.sh",
    "check:cli-build": "bash scripts/check-cli-build.sh",
    "check:host-packages": "node scripts/check-host-packages.mjs",
    "check:provenance": "node scripts/check-provenance.mjs",
    "check:tracked-output": "bash scripts/check-tracked-output.sh",
    "check:web-build": "node scripts/check-web-build.mjs",
    "verify:release": "node scripts/verify-release-directory.mjs",
    "preview": "vite preview",
    "test": "bash tests/test-boundaries.sh && node --test web/tests/*.test.mjs && cargo test --locked --manifest-path cli/Cargo.toml",
    "test:isolated": "bash tests/test-isolated-build.sh"
  },
  "dependencies": {
    "@noble/hashes": "2.3.0",
    "ajv": "8.20.0",
    "android-fastboot": "1.1.3"
  },
  "devDependencies": {
    "vite": "8.2.2"
  }
}
